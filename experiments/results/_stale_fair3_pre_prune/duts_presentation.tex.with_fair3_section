\section{santos3 -- quality}
% ============================================================================
\begin{frame}{How santos3 was built}{A fairness-enriched variant of the base santos benchmark}
\small
\begin{itemize}
  \item Starting point: base \textbf{santos} (550 datalake tables, 50 query tables).
  \item Enrichment adds tuples to \highlight{both sides} -- query tables \emph{and} datalake tables -- not datalake only.
  \item Every enriched datalake table has a paired original: \highlight{381} \texttt{\_fair} tables, one per base table selected for enrichment (the other 169 base tables are left as is).
  \item \highlight{All 48} usable query tables are fair-rebalanced -- 100\% of the query side is enriched, none of it is the untouched original.
\end{itemize}
\vspace{6pt}
\textbf{Choosing what to enrich, per table}
\begin{itemize}\small
  \item Pick a categorical column at random, subject to a domain-size threshold of \highlight{50} distinct values -- the same $\theta_{\mathrm{cat}}=50$ threshold the pipeline itself uses to call a column categorical.
  \item Pick one value from that column's domain as the distributional value $M$.
  \item Add tuples until $M$'s proportion moves toward the target fraction $F^\star$.
\end{itemize}
\vspace{4pt}
{\footnotesize\color{Muted} This is why query tables systematically sit \emph{above} $F^\star$ in the quality slides that follow (median $F_Q\approx 0.43$) -- the enrichment target and the search target are the same fraction, applied from two different directions.}
\end{frame}

\begin{frame}{santos3: why \emph{solvable-only}, $\alpha=2$, $k\in\{3,5\}$}
\begin{columns}[T]
\begin{column}{0.55\textwidth}
\textbf{Why restrict the query set at all}
\begin{itemize}\small
  \item Most santos3 failures are \texttt{insufficient\_\allowbreak candidates} -- retrieval alone didn't reach $k$
  \item Those rows have \emph{no} Stage 1, \emph{no} Stage 2, \emph{no} timings -- they dilute every mean without saying anything about the optimizer
  \item So: keep only queries where brute-force enumeration of every $k$-subset of $D$ proves $\tau$ is \emph{reachable}
\end{itemize}
\vspace{4pt}
\textbf{Why $\alpha=2$, $k\in\{3,5\}$}
\begin{itemize}\small
  \item These are santos3's native operating point ($\mathrm{top\_n}{=}100$): mean $|D|\approx 15$
  \item Large enough $k$ to be a real result size, small enough that a majority of queries still clear $|D|\geq k$
\end{itemize}
\end{column}
